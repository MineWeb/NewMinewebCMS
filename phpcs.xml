<?xml version="1.0"?>
<ruleset name="MineWeb CMS">
    <description>Code style rules for MineWeb CMS</description>

    <rule ref="CakePHP">
        <exclude name="PSR12.Files.DeclareStrictTypes"/>
    </rule>

    <file>src</file>
    <file>config</file>
    <file>templates</file>
    <file>tests</file>

    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>tmp/*</exclude-pattern>
    <exclude-pattern>logs/*</exclude-pattern>
</ruleset>
